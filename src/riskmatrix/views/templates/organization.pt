<metal:block use-macro="main_template"
             xmlns="http://www.w3.org/1999/xhtml"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             xmlns:metal="http://xml.zope.org/namespaces/metal"
             xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             i18n:domain="riskmatrix">

    <tal:block metal:fill-slot="content">
        <div class="container">
            <h1>${title}</h1>

            <!-- Organization Form -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title" i18n:translate>Organization Details</h5>
                    <form id="edit-organization-form" method="POST" novalidate>
                        <input type="hidden" name="csrf_token" value="${csrf_token}" />
                        <div class="mb-3" tal:repeat="field form">
                            ${field.label(class_='form-label')}
                            ${field(class_='form-control')}
                            <div class="invalid-feedback" tal:repeat="error field.errors">${error}</div>
                        </div>
                        <button type="submit" class="btn btn-primary" i18n:translate>Save Changes</button>
                    </form>
                </div>
            </div>

            <!-- Users Table -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0" i18n:translate>Organization Users</h5>
                        <div tal:condition="top_buttons">
                            <tal:block tal:repeat="button top_buttons">
                                ${button}
                            </tal:block>
                        </div>
                    </div>
                    ${table}
                </div>
            </div>
        </div>
    </tal:block>

    <tal:block metal:fill-slot="modals">
        <!-- Add User Modal -->
        <div class="modal fade" id="edit-xhr" tabindex="-1" aria-labelledby="edit-xhr-label" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="edit-xhr-label" i18n:translate>Add User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="edit-xhr-form" method="POST" novalidate>
                        <div class="modal-body">
                            <input type="hidden" name="csrf_token" value="${csrf_token}" />
                            <div class="mb-3" tal:repeat="field edit_form">
                                ${field.label(class_='form-label')}
                                ${field(class_='form-control')}
                                <div class="invalid-feedback" tal:repeat="error field.errors">${error}</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" i18n:translate>Cancel</button>
                            <button type="submit" class="btn btn-primary" i18n:translate>Add User</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </tal:block>

</metal:block> 