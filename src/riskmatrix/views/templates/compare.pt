<metal:block use-macro="main_template"
             xmlns="http://www.w3.org/1999/xhtml"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             xmlns:metal="http://xml.zope.org/namespaces/metal"
             xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             i18n:domain="riskmatrix">


    <tal:block metal:fill-slot="content">

        <h1>${title}</h1>

        <div class="container container-full text-center">
            <div class="row">
                <div class="col col-6" style="padding-right: 24px">
                    <h5 style="margin-left:2px; color: #ADADAD; font-weight: 800; font-style: italic; font-family: serif; margin-bottom: 0px;">Aktuelles Assessment</h5>
                    <br/>
                    <div style="width: 100%">
                        ${left_plot}
                    </div>
                </div>
                <div class="col col-6" style="padding-left: 24px">
                    <h5 style="margin-left:2px; color: #ADADAD; font-weight: 800; font-style: italic; font-family: serif; margin-bottom: 0px;">
                        ${comparison_assessment.name} (${comparison_assessment.finished_at.strftime('%d.%m.%Y %H:%M')})
                    </h5>
                    
                    <br/>
                    <div style="width: 100%">
                        ${right_plot}
                    </div>
                </div>
            </div>
        </div>

        <div style="display: block; padding: 24px"></div>

        <div class="container container-full">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th i18n:translate="">Nr.</th>
                            <th i18n:translate="">Name</th>
                            <th i18n:translate="">Asset</th>
                            <th i18n:translate="">Likelihood</th>
                            <th i18n:translate="">Change in Likelihood</th>
                            <th i18n:translate="">Impact</th>
                            <th i18n:translate="">Change in Impact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr tal:repeat="risk table.query()">
                            <td>${risk.nr}</td>
                            <td>${risk.name}</td>
                            <td>${risk.asset_name}</td>
                            <td>${risk.likelihood}</td>
                            <td>
                                <span tal:condition="risk.diff_likelihood is not None" style="color: ${risk.diff_likelihood < 0 and '#28a745' or '#dc3545'}">
                                    ${risk.diff_likelihood}
                                </span>
                            </td>
                            <td>${risk.impact}</td>
                            <td>
                                <span tal:condition="risk.diff_impact is not None" style="color: ${risk.diff_impact < 0 and '#28a745' or '#dc3545'}">
                                    ${risk.diff_impact}
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </tal:block>

</metal:block>
