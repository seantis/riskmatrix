<metal:block use-macro="main_template"
             xmlns="http://www.w3.org/1999/xhtml"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             xmlns:metal="http://xml.zope.org/namespaces/metal"
             xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             i18n:domain="riskmatrix">

    <tal:block metal:fill-slot="content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 text-center">
                    <h1 class="mt-5">${title}</h1>
                    
                    <div class="mt-4">
                        <p class="lead" i18n:translate>Welcome to RiskMatrix. Please sign in or create a new organization to get started.</p>
                    </div>

                    <div class="mt-4">
                        <a href="${request.route_url('login')}" class="btn btn-primary btn-lg me-3" i18n:translate>Sign In</a>
                        <tal:block tal:repeat="button top_buttons">
                            ${button}
                        </tal:block>
                    </div>
                </div>
            </div>
        </div>
    </tal:block>

</metal:block> 